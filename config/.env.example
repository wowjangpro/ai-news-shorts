# ══════════════════════════════════════
# AI 뉴스 쇼츠 - 환경 설정
# ══════════════════════════════════════
# 이 파일을 config/.env로 복사한 뒤 값을 채워 넣으세요.

# ── 디스코드 봇 ──
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ── YouTube ──
YOUTUBE_UPLOAD=true

# ── TTS ──
TTS_VOICE=ko-KR-InJoonNeural
TTS_RATE=+40%

# ── 영상 ──
VIDEO_FPS=24
VIDEO_CRF=20

# ── 일러스트 생성 (ollama) ──
OLLAMA_URL=http://localhost:11434
OLLAMA_IMAGE_MODEL=x/z-image-turbo
