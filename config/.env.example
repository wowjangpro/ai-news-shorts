# ══════════════════════════════════════
# AI 뉴스 쇼츠 - 환경 설정
# ══════════════════════════════════════

# 이미지 생성 (Replicate API)
# https://replicate.com/account/api-tokens 에서 발급
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YouTube 업로드
YOUTUBE_UPLOAD=false
# client_secret.json을 config/ 디렉토리에 저장

# Claude API (기사 요약용, 선택)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 기본 설정
IMAGE_SOURCE=replicate    # replicate | local | stock | graphic
TTS_VOICE=ko-KR-SunHiNeural   # ko-KR-InJoonNeural (남성)
TTS_RATE=-10%
VIDEO_FPS=30
VIDEO_CRF=20
